@model ContentModel
@inject IPageMetaDataResolver PageMetaDataResolver

@{
    string? buttonText = Model.GetButtonText(); // TODO: Sort form/section
    PageModel? page = Model as PageModel;

    if (page is not null)
    {
        PageMetaData2? buttonMetaData = page.MetaData2.FindButton();
        buttonText = buttonMetaData is not null ? await PageMetaDataResolver.ResolveAsync(buttonMetaData) : null;
    }
}

@using (Html.BeginForm(Model))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id.Value)
    @Html.HiddenFor(m => m.Path.Value)
    @Html.HiddenFor(m => m.TypeName)
    @Html.HiddenFor(m => m.ViewName)

    if (page is not null)
    {
        @if (page.LinkedToNode is not null)
        {
            @Html.HiddenFor(m => page.LinkedToNode.Value)
        }

        @Html.HiddenFor(m => page.LinkToTreeNode)
        @Html.HiddenFor(m => page.MetaData.Group.Value)
    }
    
    @await Html.PartialAsync(Model.ViewName, Model)
    
    @if (Model is FormModel form)
    {
        if (form.SubmitType == SubmitTypes.Form && buttonText is not null)
        {
            <govuk-button type="submit" disabled="!@form.CanSubmit">@buttonText</govuk-button>
        }
    }
    else 
    {
        @if (buttonText is not null)
        {
            <govuk-button type="submit">@buttonText</govuk-button>
        }
    }
}