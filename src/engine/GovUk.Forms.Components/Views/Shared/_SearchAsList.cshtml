@model GovUk.Forms.Domain.Search.SearchResultModel

@{
    string resultOverview = $"Showing {Model.StartPageNumber} to {Model.EndPageNumber} of " +
                            $"{Model.TotalResults} results for <strong>{Model.SearchText}</strong>";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <p class="govuk-body">@Html.Raw(resultOverview)</p>
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    </div>
</div>

<br />

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <ul class="govuk-list govuk-list--divided">
            @foreach (var row in Model.Results)
            {

                <li>
                    @{
                        var displayableColumns = Model.Definition.Results.Where(f => f.IsDisplayable).OrderBy(x => x.Order).ToList();
                    }
    
                    @foreach (var column in displayableColumns)
                    {
                        string value = column.GetValueForNames(row.Fields);
        
                        if (Model.IsFirstDisplayableColumn(column))
                        {
                            <h2 class="govuk-heading-s">
                                @Html.Raw(Model.GetResultDetailLink(row, value))
                            </h2>
                            break;
                        }
                    }
    
                    <dl class="govuk-summary-list govuk-summary-list--no-border">
                        @foreach (var column in displayableColumns)
                        {
                            string value = column.GetValueForNames(row.Fields);
            
                            if (!Model.IsFirstDisplayableColumn(column))
                            {
                                <div class="govuk-summary-list__row">
                                    <dt class="govuk-summary-list__key govuk-!-padding-top-1 govuk-!-padding-bottom-1">
                                        @column.Header
                                    </dt>

                                    <dd class="govuk-summary-list__value govuk-!-padding-top-1 govuk-!-padding-bottom-1">
                                        @value
                                    </dd>
                                </div>
                            }
                        }
                    </dl>

                    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

                </li>
            }
        </ul>
    </div>
</div>




















