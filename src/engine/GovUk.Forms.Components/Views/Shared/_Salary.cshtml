@model SalaryModel
@inject IPageMetaDataResolver PageMetaDataResolver

@{
    PageMetaData2 questionMetaData = Model.MetaData2.GetQuestion();
    string question = await PageMetaDataResolver.ResolveAsync(questionMetaData);
    
    PageMetaData2 hintMetaData = Model.MetaData2.GetHint();
    string hint = await PageMetaDataResolver.ResolveAsync(hintMetaData);
}

<govuk-input for="@Model.Value" input-attributes="@InputAttributes.AutoFocus" input-class="govuk-input--width-10" inputmode="numeric">
    <govuk-input-label is-page-heading="true" class="govuk-label--l">@question</govuk-input-label>
    <govuk-input-hint>@hint</govuk-input-hint>
    <govuk-input-prefix>&pound;</govuk-input-prefix>
</govuk-input>