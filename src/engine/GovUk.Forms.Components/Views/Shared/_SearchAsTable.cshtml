@using GovUk.Forms.Domain.Search.Formatting
@model GovUk.Forms.Domain.Search.SearchResultModel

@{
    ResultDetailLinkFieldValueFormatter detailLinkFormatter = new(Model.ResultDetailPath);
    string resultOverview = $"Showing {Model.StartPageNumber} to {Model.EndPageNumber} of {Model.TotalResults} results for <strong>{Model.SearchText}</strong>";
}

<p class="govuk-body">@Html.Raw(resultOverview)</p>
<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
<table class="govuk-table">
    <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">
        Search results table
    </caption>
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
        @foreach (var column in Model.Definition.Fields.Where(f => f.ResultView).OrderBy(x => x.Order))
        {
            <th scope="col" class="govuk-table__header">
                @column.Header
            </th>
        }
        <th scope="col" class="govuk-table__header"> </th>
    </tr>
    </thead>

    <tbody class="govuk-table__body">
    @foreach (var row in Model.Results)
    {
        <tr class="govuk-table__row">

            @foreach (var column in Model.Definition.Fields.Where(f => f.ResultView).OrderBy(x => x.Order))
            {
                string value = string.Empty;
                
                // TODO: Get all values for fields in row that match the list of column.Names
                if (row.Fields.TryGetValue(column.Name, out string? fieldValue))
                {
                    value = column.GetFormattedValue(fieldValue);
                }

                if (Model.Definition.Fields.IndexOf(column) == 0)
                {
                    <td class="govuk-table__cell">
                        @Html.Raw(detailLinkFormatter.Format(value))
                    </td>
                }
                else
                {
                    <td class="govuk-table__cell @column.Css">
                        @Html.Raw(value)
                    </td>   
                }
            }
        </tr>
    }
    </tbody>
</table>