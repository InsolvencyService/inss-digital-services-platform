@model Inss.Platform.Domain.Page

@{
    string? buttonText = "Continue";
}

@using (Html.BeginForm(Model))
{
    @Html.AntiForgeryToken()

    @for (int index = 0; index < Model.Components.Count; index++)
    {
        @await Html.RenderPageComponentAsync(Model.Components[index], $"Components[{index}]")
    }
    
    <govuk-button type="submit">@buttonText</govuk-button>
}