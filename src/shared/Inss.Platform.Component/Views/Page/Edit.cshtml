@model PageModel

@{
    ViewData["PageTitle"] = Model.Title;
    ViewData["DisplayFullWidth"] = Model.DisplayFullWidth;
    ViewData["PreviousPage"] = Model.PreviousPage?.Value;
    ComponentModelList beforeFormComponents = Model.Components.GetComponentTypeOf(ComponentTypes.BeforeForm);
    ComponentModelList bindableComponents = Model.Components.GetComponentTypeOf(ComponentTypes.Bindable);
    ComponentModelList afterFormComponents = Model.Components.GetComponentTypeOf(ComponentTypes.AfterForm);
}

@foreach (ComponentModel component in beforeFormComponents)
{
    @await Html.RenderPageComponentAsync(component)
}

@using (Html.BeginForm(Model))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Title)
    @Html.HiddenFor(m => m.Path.Value)

    @if (Model.QueryParams is not null)
    {
        @Html.HiddenFor(m => m.QueryParams)
    }

    @foreach (ComponentModel component in bindableComponents)
    {
        int index = Model.Components.IndexOf(component);
        @Html.Hidden($"Components[{index}].Id.Value", Model.Components[index].Id.Value)
        @Html.Hidden($"Components[{index}].TypeName", Model.Components[index].TypeName)
        @await Html.RenderPageComponentAsync(Model.Components[index], $"Components[{index}]")
    }

    if (!string.IsNullOrWhiteSpace(Model.SubmitButton))
    {
        <govuk-button type="submit">@Model.SubmitButton</govuk-button>
    }
}

@foreach (ComponentModel component in afterFormComponents)
{
    @await Html.RenderPageComponentAsync(component)
}