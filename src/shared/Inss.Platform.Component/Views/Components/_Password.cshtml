@model PasswordComponentModel

<div class="govuk-form-group govuk-password-input govuk-!-width-two-thirds">
    <govuk-password-input for="@Model.Value" autocomplete="current-password" show-password-text="Show" label-class="govuk-label--s">
        <govuk-password-input-label>@(Model.Question)</govuk-password-input-label>
    </govuk-password-input>
</div>