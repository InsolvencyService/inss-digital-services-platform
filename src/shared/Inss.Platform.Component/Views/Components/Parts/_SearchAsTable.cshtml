@using Inss.Platform.Domain.Components.Searching.Support
@model SearchResultComponentModel

@{
    string resultOverview = $"Showing {Model.StartPageNumber} to {Model.EndPageNumber} of " +
                            $"{Model.TotalResults} results for <strong>{Model.Value}</strong>";
}

<p class="govuk-body">@Html.Raw(resultOverview)</p>
<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
<table class="govuk-table">
    <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">
        Search results table
    </caption>
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
        @foreach (SearchResultDefinition column in Model.GetOrderedDisplayResults())
        {
            <th scope="col" class="govuk-table__header">
                @column.Header
            </th>
        }
        <th scope="col" class="govuk-table__header"> </th>
    </tr>
    </thead>

    <tbody class="govuk-table__body">
    @foreach (var row in Model.Results)
    {
        <tr class="govuk-table__row">

            @foreach (SearchResultDefinition column in Model.GetOrderedDisplayResults())
            {
                string value = column.GetValueForNames(row.Fields);
                
                if (Model.IsFirstDisplayableColumn(column))
                {
                    <td class="govuk-table__cell">
                        @Html.Raw(Model.GetResultDetailLink(row, value))
                    </td>
                }
                else
                {
                    <td class="govuk-table__cell @column.Css">
                        @Html.Raw(value)
                    </td>   
                }
            }
        </tr>
    }
    </tbody>
</table>